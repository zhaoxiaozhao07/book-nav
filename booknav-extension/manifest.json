{
  "manifest_version": 3,
  "name": "书签助手",
  "version": "1.0.0",
  "description": "将当前页面快速保存到导航站，并支持 AI 推荐已有分类。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "添加书签",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
